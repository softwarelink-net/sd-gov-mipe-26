{
  "name": "sd-gov-mipe-26",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -b --noEmit",
    "lint": "vue-tsc -b --noEmit",
    "postinstall": "node -e \"import('node:fs').then(fs=>{fs.mkdirSync('public',{recursive:true});fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm','public/sql-wasm.wasm');try{fs.copyFileSync('node_modules/sql.js/dist/sql-wasm-browser.wasm','public/sql-wasm-browser.wasm')}catch(e){}})\"",
    "capture": "node scripts/capture-dashboard.mjs",
    "upload:r2": "node scripts/deploy-allworld.mjs sd-gov-mipe-26",
    "deploy": "npm run build && node scripts/deploy-allworld.mjs sd-gov-mipe-26"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "echarts": "^6.1.0",
    "pinia": "^4.0.3",
    "sql.js": "^1.14.2",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.5",
    "playwright": "^1.55.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.12"
  }
}
